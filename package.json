{
  "name": "pi-chrome-profiles",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moshioshimayo/pi-chrome-profiles.git"
  },
  "homepage": "https://github.com/moshioshimayo/pi-chrome-profiles#readme",
  "bugs": {
    "url": "https://github.com/moshioshimayo/pi-chrome-profiles/issues"
  },
  "keywords": [
    "pi-package",
    "chrome",
    "playwright",
    "browser-automation"
  ],
  "description": "Pi extension: drive one named real Chrome profile at a time through the official Playwright MCP Chrome extension relay",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "files": [
    "src/",
    "index.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "verify": "node --test && ./scripts/loader-smoke.sh",
    "verify:ui": "python3 scripts/wizard-smoke.py"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/mcp": "0.0.83"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "1.2.0",
    "typebox": "1.4.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
